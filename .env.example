# ============================================================================
# TURAB ROOT - ENVIRONMENT VARIABLES
# ============================================================================
# 
# IMPORTANT SECURITY NOTES:
# - Copy this file to .env.local and fill in your actual values
# - NEVER commit .env.local to Git (it should be in .gitignore)
# - Keep all secrets secure and unique per environment
# - Never use the same secret in development and production
# - Rotate secrets periodically for security
#
# ============================================================================

# ============================================================================
# NODE ENVIRONMENT
# ============================================================================
# Set to "production" on VPS, "development" locally
NODE_ENV=development

# ============================================================================
# DATABASE CONFIGURATION
# ============================================================================
# For development (SQLite - local file-based):
DATABASE_URL="file:./prisma/dev.db"

# For production (PostgreSQL - recommended):
# DATABASE_URL="postgresql://username:password@hostname:5432/database_name"
# 
# PostgreSQL connection string format:
# postgresql://[user[:password]@][netloc][:port][/dbname][?param1=value1&...]
#
# Example:
# DATABASE_URL="postgresql://turab_user:secure_password_here@db.example.com:5432/turab_db"

# ============================================================================
# NEXTAUTH CONFIGURATION
# ============================================================================
# Generate a secure random secret using:
# openssl rand -base64 32
#
# This secret is used to encrypt JWT tokens and other sensitive data
NEXTAUTH_SECRET="generate-this-with-openssl-rand-base64-32-replace-me"

# Your application URL (used for redirects and callbacks)
# Development:
NEXTAUTH_URL="http://localhost:3000"

# Production:
# NEXTAUTH_URL="https://yourdomain.com"

# ============================================================================
# AUTHENTICATION SETTINGS
# ============================================================================
# Maximum session duration (in seconds)
# Default: 24 * 60 * 60 = 86400 (24 hours)
SESSION_MAX_AGE=86400

# JWT expiration time (in seconds)
# Should match SESSION_MAX_AGE
JWT_MAX_AGE=86400

# ============================================================================
# SERVER CONFIGURATION
# ============================================================================
# Server port (default 3000)
# Nginx will proxy to this port on the VPS
PORT=3000

# Server hostname (0.0.0.0 = listen on all interfaces)
HOSTNAME="0.0.0.0"

# ============================================================================
# SOCKET.IO CONFIGURATION
# ============================================================================
# Socket.IO path (should match server.ts configuration)
SOCKET_IO_PATH="/api/socketio"

# Allowed origins for Socket.IO connections (comma-separated)
# Development: http://localhost:3000
# Production: https://yourdomain.com
# ALLOWED_SOCKET_IO_ORIGINS="http://localhost:3000,https://yourdomain.com"

# ============================================================================
# FILE UPLOAD CONFIGURATION
# ============================================================================
# Maximum file upload size (in bytes)
# Default: 50MB = 52428800
MAX_FILE_UPLOAD_SIZE=52428800

# Allowed file types for uploads (comma-separated MIME types)
ALLOWED_UPLOAD_TYPES="video/mp4,video/webm,image/jpeg,image/png,image/gif"

# Upload directory (relative to project root)
UPLOAD_DIR="public/uploads"

# ============================================================================
# LOGGING & MONITORING
# ============================================================================
# Log level: debug, info, warn, error
LOG_LEVEL="info"

# Enable detailed query logging (can impact performance, use only in development)
DEBUG_QUERIES="false"

# Enable audit logging for security events
ENABLE_AUDIT_LOGGING="true"

# ============================================================================
# EMAIL CONFIGURATION (Optional)
# ============================================================================
# For sending email notifications, password resets, etc.
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT="587"
# SMTP_USER="your-email@gmail.com"
# SMTP_PASSWORD="your-app-password"
# SMTP_FROM="noreply@yourdomain.com"

# ============================================================================
# STRIPE CONFIGURATION (Optional - if using payments)
# ============================================================================
# STRIPE_PUBLIC_KEY="pk_test_..."
# STRIPE_SECRET_KEY="sk_test_..."
# STRIPE_WEBHOOK_SECRET="whsec_..."

# ============================================================================
# SECURITY HEADERS
# ============================================================================
# Content Security Policy (CSP) can be configured via middleware
# CORS origins (configure in server.ts for Socket.IO)
# CORS_ALLOWED_ORIGINS="http://localhost:3000,https://yourdomain.com"

# ============================================================================
# RATE LIMITING
# ============================================================================
# API rate limit: requests per time window
# Default: 100 requests per 15 minutes
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_MS=900000

# Login attempt rate limit: max attempts before lockout
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_DURATION_MS=900000  # 15 minutes

# ============================================================================
# DEVELOPMENT TOOLS
# ============================================================================
# Run Next.js with React Strict Mode for development
REACT_STRICT_MODE="true"

# Enable debug logging in development
DEBUG="next*"

# ============================================================================
# DEPLOYMENT
# ============================================================================
# For VPS deployment with PM2
# PM2_INSTANCE_NAME="turab-root"
# PM2_LOG_DIR="/var/www/turab-root/logs"

# ============================================================================
# IMPORTANT: SETUP INSTRUCTIONS
# ============================================================================
#
# 1. Copy this file to .env.local:
#    cp .env.example .env.local
#
# 2. Fill in all required values (marked with "replace-me" or examples)
#
# 3. Generate secure secrets:
#    openssl rand -base64 32  # For NEXTAUTH_SECRET
#
# 4. For database setup:
#    - SQLite (dev): DATABASE_URL="file:./prisma/dev.db"
#    - PostgreSQL (prod): Create database and user, update DATABASE_URL
#
# 5. Initialize database:
#    npx prisma db push
#
# 6. Create initial admin user:
#    # Use the setup CLI tool (to be created)
#    # Or manually create via database GUI
#
# 7. Test authentication:
#    npm run dev
#    Navigate to /admin/login
#    Login with admin credentials
#
# 8. NEVER commit .env.local to Git:
#    Check .gitignore includes: .env.local
#
# ============================================================================
# SECURITY CHECKLIST
# ============================================================================
#
# Development Machine:
# ☐ NEXTAUTH_SECRET is long and random (32+ characters)
# ☐ DATABASE_URL points to local SQLite
# ☐ NEXTAUTH_URL is http://localhost:3000
# ☐ All required variables are filled in
#
# VPS / Production:
# ☐ NEXTAUTH_SECRET is different from development
# ☐ DATABASE_URL points to secure PostgreSQL
# ☐ NEXTAUTH_URL matches your domain (https://)
# ☐ NODE_ENV is set to "production"
# ☐ .env.local is NOT in version control
# ☐ File permissions: .env.local is readable only by app user (600)
# ☐ All secrets are strong and unique
# ☐ Rate limiting is configured
# ☐ CORS origins are restricted to your domain
# ☐ File upload directory is outside web root
#
# ============================================================================
